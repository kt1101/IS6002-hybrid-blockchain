# Kafka 2.7.0 (with bundled ZooKeeper) broker image for the Kafka-ordering Veritas variant.
FROM eclipse-temurin:11-jre

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://archive.apache.org/dist/kafka/2.7.0/kafka_2.12-2.7.0.tgz | tar -xz -C /opt \
 && ln -s /opt/kafka_2.12-2.7.0 /opt/kafka

WORKDIR /opt/kafka
