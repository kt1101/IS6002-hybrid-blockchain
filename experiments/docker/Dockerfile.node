# Runtime image for every Veritas node (Redis, Tendermint, tc/iptables for fault injection, our binaries).
FROM debian:bullseye-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends redis-server iproute2 iptables ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Explicit names so stale or host-built (non-linux) files left in bin/ never reach the image.
COPY bin/veritas-kafka bin/veritas-tm bin/veritas-tso bin/ycsbbench bin/tendermint /usr/local/bin/
