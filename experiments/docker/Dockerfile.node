# Runtime image for every Veritas node (Redis 6.2, Tendermint, tc/iptables for fault injection, our binaries).
FROM redis:6.2-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends iproute2 iptables ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY bin/ /usr/local/bin/

# Do not auto-start redis as the main process; later tasks start redis-server and veritas explicitly.
ENTRYPOINT []
CMD ["sleep", "infinity"]
