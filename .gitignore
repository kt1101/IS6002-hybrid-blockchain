# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
#
# Logs
scripts/logs*

# Experiment toolchain
scripts/temp/
bin/
results/raw/
experiments/cluster/generated/
__pycache__/
.superpowers/
results/ycsb/

# Per-run sidecars of the final data set (rebuilt by experiments/plot/assemble_final.py)
results/final/*/

# Per-run sidecars of the cloud final data set (rebuilt by experiments/cloud/assemble.py)
results/cloud-bf100ms/final/*/
